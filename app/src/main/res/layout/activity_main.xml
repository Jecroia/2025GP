<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app   ="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id ="@+id/rootLayout"
    android:fitsSystemWindows="true"
    android:layout_width ="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- 툴바 -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light">

        <ImageButton
            android:id="@+id/btnToggleSeekBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:background="@android:color/transparent"
            android:contentDescription="토글"
            android:padding="8dp"
            android:src="@drawable/baseline_toggle_off_24" />

        <!-- 툴 패널 토글/도구 토글용 버튼 -->
        <com.example.scoreviewer.CanvasToggleButton
            android:id="@+id/btnCanvas"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/tool_pen_24"
            android:contentDescription="캔버스 도구 열기/닫기 또는 활성화/비활성화"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <ImageButton
            android:id="@+id/btnUndo"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="되돌리기"
            android:src="@drawable/tool_undo_24" />

        <ImageButton
            android:id="@+id/btnRedo"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="다시실행"
            android:src="@drawable/tool_redo_24" />

        <ImageButton
            android:id="@+id/btnPlay"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="재생"
            android:src="@drawable/ic_play_arrow_24" />

        <ImageButton
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="저장"
            android:src="@drawable/tool_save_24" />


    </androidx.appcompat.widget.Toolbar>

    <!-- 상단 페이지 탐색 SeekBar -->
    <SeekBar
        android:id              ="@+id/pageSeekBar"
        android:layout_width    ="0dp"
        android:layout_height   ="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background      ="#FFB6C1"
        android:elevation       ="8dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/viewPager"/>

    <!-- PDF 뷰어 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id             ="@+id/viewPager"
        android:layout_width   ="0dp"
        android:layout_height  ="0dp"
        android:background     ="#FFFFFF"
        app:layout_constraintTop_toBottomOf   ="@id/pageSeekBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf ="parent"
        app:layout_constraintEnd_toEndOf     ="parent"/>

    <!-- 필기 오버레이 Canvas -->
    <com.example.scoreviewer.AnnotationCanvasView
        android:id            ="@+id/annotationCanvas"
        android:layout_width  ="0dp"
        android:layout_height ="0dp"
        android:clickable     ="true"
        android:longClickable="true"
        android:focusable     ="true"
        app:layout_constraintTop_toTopOf="@id/viewPager"
        app:layout_constraintBottom_toBottomOf="@id/viewPager"
        app:layout_constraintStart_toStartOf="@id/viewPager"
        app:layout_constraintEnd_toEndOf="@id/viewPager"/>

    <!-- 썸네일/Inline-EditText 컨테이너 -->
    <FrameLayout
        android:id           ="@+id/thumbnail_container"
        android:layout_width ="match_parent"
        android:layout_height="match_parent"
        android:clipChildren ="false"
        android:clipToPadding="false"/>

    <!-- 캔버스 도구 패널 -->
    <include
        android:id            ="@+id/canvasToolsPanel"
        layout               ="@layout/canvas_tools"
        android:visibility   ="gone"
        android:layout_width ="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
