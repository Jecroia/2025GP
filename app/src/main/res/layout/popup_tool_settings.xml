<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="8dp"
    android:background="@drawable/popup_bg">

    <!-- 크기 조절 레이블 -->
    <TextView
        android:id="@+id/tvSizeLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="크기"
        android:textSize="14sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 크기 조절 SeekBar -->
    <SeekBar
        android:id="@+id/seekBarSize"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:max="100"
        app:layout_constraintTop_toBottomOf="@id/tvSizeLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 색상 선택 레이블 -->
    <TextView
        android:id="@+id/tvColorLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="색상"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/seekBarSize"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"/>

    <!-- 색상 그리드 -->
    <GridLayout
        android:id="@+id/gridColors"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:rowCount="2"
        android:columnCount="5"
        app:layout_constraintTop_toBottomOf="@id/tvColorLabel"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp">

        <!-- 예시: 10가지 컬러 뷰 -->
        <View
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_margin="4dp"
            android:tag="#FF000000"
            android:backgroundTint="#FF000000"/>

        <View
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_margin="4dp"
            android:tag="#FFFF0000"
            android:backgroundTint="#FFFF0000"/>

        <View
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_margin="4dp"
            android:tag="#FF00FF00"
            android:backgroundTint="#FF00FF00"/>

        <View
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_margin="4dp"
            android:tag="#FF0000FF"
            android:backgroundTint="#FF0000FF"/>

        <View
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_margin="4dp"
            android:tag="#FFFFFF00"
            android:backgroundTint="#FFFFFF00"/>

        <View
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_margin="4dp"
            android:tag="#FFFF00FF"
            android:backgroundTint="#FFFF00FF"/>

        <View
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_margin="4dp"
            android:tag="#FF00FFFF"
            android:backgroundTint="#FF00FFFF"/>

        <View
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_margin="4dp"
            android:tag="#FF888888"
            android:backgroundTint="#FF888888"/>

        <View
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_margin="4dp"
            android:tag="#FF444444"
            android:backgroundTint="#FF444444"/>

        <View
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_margin="4dp"
            android:tag="#FFFFFFFF"
            android:backgroundTint="#FFFFFFFF"/>
    </GridLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
