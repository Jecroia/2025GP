<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panelContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="#E5F4E8"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- 1) 도구 버튼 4개 행 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Pen 버튼 -->
        <ImageButton
            android:id="@+id/btnPen"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/tool_button_background"
            android:contentDescription="펜"
            android:scaleType="centerInside"
            android:src="@drawable/tool_pen_24" />

        <!-- Highlighter 버튼 -->
        <ImageButton
            android:id="@+id/btnHighlighter"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/tool_button_background"
            android:contentDescription="형광펜"
            android:scaleType="centerInside"
            android:src="@drawable/tool_highlight_24" />

        <!-- Text 버튼 -->
        <ImageButton
            android:id="@+id/btnText"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/tool_button_background"
            android:contentDescription="텍스트"
            android:scaleType="centerInside"
            android:src="@drawable/tool_text_24" />

        <!-- Eraser 버튼 -->
        <ImageButton
            android:id="@+id/btnEraser"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/tool_button_background"
            android:contentDescription="지우개"
            android:scaleType="centerInside"
            android:src="@drawable/tool_eraser_24" />
    </LinearLayout>

    <!-- 2) 크기 조절 영역 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/canvasPreviewSizeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="크기:"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnDecreaseSize"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/tool_button_background"
            android:contentDescription="크기 감소"
            android:scaleType="centerInside"
            android:src="@drawable/ic_remove_24" />

        <!-- 현재 크기를 표시 -->
        <TextView
            android:id="@+id/canvasPreviewSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:text="48"
            android:textSize="14sp" />

        <!-- 크기 증가 -->
        <ImageButton
            android:id="@+id/btnIncreaseSize"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/tool_button_background"
            android:contentDescription="크기 증가"
            android:scaleType="centerInside"
            android:src="@drawable/ic_add_24" />
    </LinearLayout>

    <!-- 3) 색상 선택 영역 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/canvasPreviewColorLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="색:"
            android:textSize="14sp" />

        <View
            android:id="@+id/canvasPreviewColor"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="#FF0000" />
    </LinearLayout>

    <!-- 3-1) HoloColorPicker 뷰를 삽입할 영역 -->
    <com.larswerkman.holocolorpicker.ColorPicker
        android:id="@+id/colorPicker"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <!-- 4) 프리뷰 영역 (기존 PreviewOuter) -->
    <FrameLayout
        android:id="@+id/preview_outer"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_preview_border"
        android:padding="1dp">

        <com.example.scoreviewer.CanvasPreview
            android:id="@+id/CanvasPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

</LinearLayout>
