<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <SeekBarPreference
        android:key="sync_offset_ms"
        android:title="싱크 오프셋 조정"
        android:summary="PDF 페이지 넘김 시간 보정 (±ms)"
        android:min="-2000"
        android:max="2000"
        android:defaultValue="0" />

    <SeekBarPreference
        android:key="start_delay_sec"
        android:title="재생 시작 지연 시간"
        android:summary="재생 버튼 누른 후 대기 시간 (초)"
        android:min="0"
        android:max="10"
        android:defaultValue="0" />

</PreferenceScreen>